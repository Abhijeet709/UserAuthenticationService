# Postgres DSN consumed by asyncpg.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db

# JWT signing config. Generate a long random string for production.
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# CORS_ORIGINS must be valid JSON when parsed by pydantic-settings.
CORS_ORIGINS=["http://localhost:3000"]

# PBKDF2 iterations used when hashing passwords on signup.
PASSWORD_HASH_ITERATIONS=200000

# Standard logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
